@MinimalEP_HostAddress = http://localhost:5284
@baseUrl = {{MinimalEP_HostAddress}}/api/v1

### ============================================================
### PREREQUISITE: Login
### ============================================================

# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "superadmin@example.com",
  "password": "Sup3rSecret!"
}

@accessToken = {{login.response.body.accessToken}}

### ============================================================
### SCENARIO: Create a new customer
### ============================================================

# @name addCustomer
POST {{baseUrl}}/customers
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Acme AB",
  "email": "contact@acme.example"
}

### Expect: 201 Created — body: { id, name, email }

@customerId = {{addCustomer.response.body.id}}

### ============================================================
### SCENARIO: Get the customer by id to read its RowVersion
### (RowVersion is required for the subsequent update)
### ============================================================

# @name getCustomer
GET {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{accessToken}}

### Expect: 200 Ok — body: { id, name, email, rowVersion }

@customerRowVersion = {{getCustomer.response.body.rowVersion}}

### ============================================================
### SCENARIO: List customers (paginated)
### ============================================================

GET {{baseUrl}}/customers
Authorization: Bearer {{accessToken}}

### Expect: 200 Ok — body: { items: [...], nextCursor: guid|null }; includes "Acme AB"

### ============================================================
### SCENARIO: Update the customer (requires last-read RowVersion)
### ============================================================

PUT {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "id": "{{customerId}}",
  "name": "Acme Corporation",
  "email": "info@acme.example",
  "rowVersion": "{{customerRowVersion}}"
}

### Expect: 200 Ok — updated Name/Email reflected; stale RowVersion -> 409 Conflict

### ============================================================
### SCENARIO: Update a non-existent customer -> 404
### ============================================================

PUT {{baseUrl}}/customers/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "id": "00000000-0000-0000-0000-000000000000",
  "name": "Ghost Corp",
  "email": "ghost@example.com",
  "rowVersion": "AAAAAAAAB9E="
}

### Expect: 404 NotFound

### ============================================================
### SCENARIO: Delete the customer
### ============================================================

DELETE {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{accessToken}}

### Expect: 204 NoContent

### ============================================================
### SCENARIO: Deleting the same customer again -> 404
### ============================================================

DELETE {{baseUrl}}/customers/{{customerId}}
Authorization: Bearer {{accessToken}}

### Expect: 404 NotFound
